<Project>

  <!--
    Single source of truth for cross-project MSBuild settings.

    Bump <Version> and push to main to publish a release: auto-tag.yml sees a
    version with no matching v* tag, tags it, and starts release.yml, which
    publishes latest.zip and then updates repo.json. Leave repo.json alone;
    it should only change once the new zip exists to download.
  -->

  <PropertyGroup Label="Identity">
    <Version>0.2.2.0</Version>
    <Authors>XeldarAlz;Kongool</Authors>
    <Copyright>Copyright (c) XeldarAlz</Copyright>
    <PackageProjectUrl>https://github.com/Kongool/Parcae</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Kongool/Parcae</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Label="Determinism" Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
